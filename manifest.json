{
  "manifest_version": 3,
  "name": "GitLab Auto Collapse",
  "version": "1.0.0",
  "description": "Collapses the files that match your patterns when you review a GitLab merge request.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "GitLab Auto Collapse",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*/-/merge_requests/*"],
      "js": ["matchesAnyPattern.js", "collapseMatchingDirectories.js", "collapseMatchingFiles.js"],
      "run_at": "document_idle"
    }
  ]
}
